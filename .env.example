# Copy to `.env` (gitignored) and edit. `config.py` loads it at import; real environment
# variables always win, so `export VRR_PG_DSN=…` still overrides a line here.
#
#   cp .env.example .env

# ---- Postgres (VRR data + compute + the pgvector knowledge index) -------------
# The one setting almost everyone changes. Port 5432 is the default; a docker-compose
# stack published on another port goes here.
VRR_PG_DSN=postgresql://vrr:vrr@localhost:5432/vrr

# ---- MLflow (tracing / eval / prompt registry) --------------------------------
# macOS: port 5000 is taken by AirPlay Receiver and answers 403, so tracing silently
# stays off if you leave it there. Run the server on 5001.
MLFLOW_TRACKING_URI=http://localhost:5001

# ---- Unity Catalog OSS (governance catalog-of-record) -------------------------
VRR_UC_URL=http://localhost:8080

# ---- LLM narrator -------------------------------------------------------------
# ollama (default, local, free) | openai | anthropic — the last two are BILLABLE.
# The provider only changes who phrases the answer: every number still comes from the
# deterministic tools and still passes the faithfulness gate.
VRR_LLM_PROVIDER=ollama
VRR_LLM_MODEL=qwen2.5:7b
VRR_LLM_BASE_URL=http://localhost:11434

# Hosted providers — leave the keys blank to keep the stack fully local and free.
# A provider with no key reports itself unavailable rather than failing mid-question.
# Verify one before switching to it:  make llm-check p=anthropic
ANTHROPIC_API_KEY=
VRR_ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
VRR_OPENAI_MODEL=gpt-4o-mini

# ---- Embeddings for the knowledge index ---------------------------------------
# nomic-embed-text is 768-dim, which is the width `schema.sql` declares for
# vrr_agent.reservoir_knowledge.embedding. Changing the model means changing that
# column and re-ingesting, so it is kept separate from the narrator setting.
VRR_EMBED_PROVIDER=ollama
VRR_EMBED_MODEL=nomic-embed-text

# ---- Retrieval + chunking (RAG) -----------------------------------------------
# Chunks below this cosine similarity are noise. Without a floor, top-k always returns
# k rows, so an unanswerable question still gets excerpts and the model answers from
# them; with it, the agent says "I don't know". MEASURE it with `make floor` rather than
# guessing — nomic-embed-text scores unrelated text at ~0.40-0.56, so a low value admits
# everything. Re-measure after changing the embedding model or the corpus.
VRR_RETRIEVAL_MIN_SCORE=0.62
# recursive (default, measured best) | semantic | fixed — see `make chunks`.
# Changing this requires re-ingesting: boundaries are baked into the stored embeddings.
VRR_CHUNK_STRATEGY=recursive

# ---- API auth (OAuth2 password grant → JWT bearer) ----------------------------
# Signs the tokens. UNSET = a random key per process, so every API restart invalidates
# every token — fine for a first look, annoying for real use. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Treat it like a password: anyone holding it can mint a token for ANY role.
VRR_JWT_SECRET=
VRR_JWT_TTL_MINUTES=720
# Password `make users` gives the seeded demo accounts (analyst.demo / rm.demo /
# site.demo / steward.demo). Change it before this is reachable from anywhere else.
VRR_DEMO_PASSWORD=vrr-demo

# ---- Knowledge ingest ---------------------------------------------------------
# Where `make knowledge` looks for documents to register.
VRR_KNOWLEDGE_DIR=./knowledge_uploads
